# Секреты воркера для локальной разработки: скопируйте в `.dev.vars`.
# Без них работают гостевой вход и регистрация по почте, а ссылки подтверждения
# показываются в ответе сервера и в его консоли (только на localhost).
# На сервере те же имена задаются через `npx wrangler secret put <ИМЯ>`.
#
# Письма и вход через Google настраиваются независимо: можно включить только
# отправку писем (блок GMAIL_*), и кнопка «Продолжить с Google» не появится.

# --- Отправка писем через Gmail API (docs/auth-setup.md) --------------------
# Получаются одной командой: npm run auth:gmail-token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=Jinaly <you@gmail.com>

# --- Вход через Google (необязательно) --------------------------------------
# Включает кнопку «Продолжить с Google». Адрес возврата в Google Cloud Console:
#   http://localhost:3000/api/auth/google/callback
# Google принимает только https, кроме localhost, — на LAN-сервере по http
# этот вход работать не будет, оставьте поля пустыми.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Нужен, только если адрес возврата отличается от origin запроса.
# GOOGLE_REDIRECT_URI=

# --- Альтернатива Gmail: Resend ---------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM=Jinaly <no-reply@ваш-домен>

# --- Адрес приложения в ссылках писем --------------------------------------
# По умолчанию берётся origin запроса; задавайте, если сервер за прокси.
# APP_URL=https://jinaly.example
